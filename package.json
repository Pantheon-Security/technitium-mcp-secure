{
  "name": "technitium-mcp",
  "version": "1.3.4",
  "description": "MCP server for Technitium DNS Server management and diagnostics",
  "type": "module",
  "bin": {
    "technitium-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/",
    "lint": "biome lint src tests",
    "audit": "npm audit",
    "prepublishOnly": "rm -rf dist && npm run build && npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "22.19.11",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosschurchill/technitium-mcp-secure.git"
  },
  "bugs": {
    "url": "https://github.com/rosschurchill/technitium-mcp-secure/issues"
  },
  "homepage": "https://github.com/rosschurchill/technitium-mcp-secure#readme",
  "author": "Ross Churchill",
  "overrides": {
    "hono": "4.12.18",
    "express-rate-limit": "8.5.1",
    "ip-address": "10.2.0"
  },
  "mcpName": "io.github.rosschurchill/technitium-mcp-secure"
}
